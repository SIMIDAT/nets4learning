diff --git a/dist/kernels/Log.js b/dist/kernels/Log.js
index 557b77240c42fe41355a9a23b4f822bd72d959b5..bfe786d9df49ec938dde4568d8db646debc119b9 100755
--- a/dist/kernels/Log.js
+++ b/dist/kernels/Log.js
@@ -17,18 +17,20 @@
 import { Log } from '@tensorflow/tfjs-core';
 import { CHECK_NAN_SNIPPET_UNARY, unaryKernelFunc } from '../kernel_utils/kernel_funcs_utils';
 import { logImplCPU } from '../kernel_utils/shared';
+// N4L: NAN (uniform que TF.js pone a NaN en todos los shaders) en vez de 0./0.: Firefox en Linux traduce los
+// shaders a GLSL 1.50 y escribe la constante 0./0. como uintBitsToFloat(), que el driver de NVIDIA no compila.
 // Windows chrome return 0 if the input is negative value. We will specifically
 // return NaN if the input is 0 to solve compatiblity issue.
 const LOG = CHECK_NAN_SNIPPET_UNARY + `
-  return x < 0.0 ? 0./0. : log(x);
+  return x < 0.0 ? NAN : log(x);
 `;
 const LOG_PACKED = `
   vec4 result = log(x);
   bvec4 isNaN = isnan(x);
-  result.r = isNaN.r ? x.r : (x.r < 0.0 ? 0./0. : result.r);
-  result.g = isNaN.g ? x.g : (x.g < 0.0 ? 0./0. : result.g);
-  result.b = isNaN.b ? x.b : (x.b < 0.0 ? 0./0. : result.b);
-  result.a = isNaN.a ? x.a : (x.a < 0.0 ? 0./0. : result.a);
+  result.r = isNaN.r ? x.r : (x.r < 0.0 ? NAN : result.r);
+  result.g = isNaN.g ? x.g : (x.g < 0.0 ? NAN : result.g);
+  result.b = isNaN.b ? x.b : (x.b < 0.0 ? NAN : result.b);
+  result.a = isNaN.a ? x.a : (x.a < 0.0 ? NAN : result.a);
   return result;
 `;
 export const log = unaryKernelFunc({ opSnippet: LOG, packedOpSnippet: LOG_PACKED, cpuKernelImpl: logImplCPU });
